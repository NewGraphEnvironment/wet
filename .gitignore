.Rproj.user
.Rhistory
.RData
.Ruserdata

# PCIC downloads and pipeline outputs (large, regenerated by scripts/), except
# the small text reports and run logs that research/ cites as evidence
data/*
!data/checks/
data/checks/*
!data/checks/*.txt
!data/basin/
data/basin/*
!data/basin/*_report.txt
!data/basin/*_run.log

# Track .claude/visibility (overriding global ~/.gitignore that excludes .claude/)
!.claude/
.claude/*
!.claude/visibility

# pkgdown site and rendered vignettes
docs/
vignettes/*.html
vignettes/*_files/
